# Krauncher client configuration — copy to .env and fill in.
# Explicit KrauncherClient(...) arguments always override these.
# The .env file is git-ignored; never commit real keys.

# --- Required ---
# Your API key. Generate at https://krauncher.com → Account → API Keys.
CAS_API_KEY=cas_your_api_key_here

# --- Optional (defaults shown) ---
# Broker API base URL.
# CAS_BROKER_URL=https://krauncher.com/api

# Analyzer request timeout, seconds.
CAS_ANALYZER_TIMEOUT=10.0

# Estimate-only mode: predict cost/GPU without actually running the task.
CAS_ESTIMATE_ONLY=false

# How many times to transparently resubmit a task after an infrastructure
# failure (host lost, no capacity). Set to 0 to disable retries.
CAS_MAX_TASK_RETRIES=3

# Pin a specific GPU model / architecture (empty = let Krauncher choose).
#KRAUNCHER_GPU_NAME=
#KRAUNCHER_GPU_ARCH=

# --- Storage credentials ---
# Keys to your own S3 bucket / private HuggingFace repos. Krauncher stores
# none of them: they are read from this environment and sent encrypted to the
# worker that runs your task, never through the broker. The names are the
# standard ones, so an environment that already works with boto3 or the
# huggingface CLI needs nothing added here.
#
# Leave them unset for public data — s3:// URLs always need keys, hf:// only
# for private repos.

# S3 (required together; region and endpoint are optional).
#AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Falls back to AWS_DEFAULT_REGION.
#AWS_REGION=eu-central-1
# The S3 service this key belongs to — empty means AWS. Set it for MinIO,
# Backblaze, R2 or any other S3-compatible provider.
#AWS_ENDPOINT_URL=https://s3.example.com:9000

# HuggingFace token for private repos. Falls back to HUGGING_FACE_HUB_TOKEN.
#HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Set to false to never attach credentials — a task reading private data then
# fails on download instead of borrowing whatever profile is in this shell.
#CAS_SEND_CREDENTIALS=true

# --- Advanced / debugging ---
# Stream worker stderr back to the client.
# CAS_STREAM_STDERR=false
# Verbose client logging.
# KRAUNCHER_DEBUG=0
# Relay TLS overrides (normally delivered by the broker per task).
# KRAUNCHER_RELAY_TLS=
# KRAUNCHER_RELAY_CA=
# KRAUNCHER_RELAY_AUTHORITY=
