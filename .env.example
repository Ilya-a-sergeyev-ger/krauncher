# Krauncher client configuration — copy to .env and fill in.
# Explicit KrauncherClient(...) arguments always override these.
# The .env file is git-ignored; never commit real keys.

# --- Required ---
# Your API key. Generate at https://krauncher.com → Account → API Keys.
CAS_API_KEY=cas_your_api_key_here

# --- Optional (defaults shown) ---
# Broker API base URL.
CAS_BROKER_URL=https://krauncher.com

# End-to-end encryption of task code/data to the worker (true/false).
CAS_ENCRYPT=true

# End-to-end encryption of code sent to the analyzer (true/false).
CAS_ENCRYPT_ANALYZER=true

# Analyzer request timeout, seconds.
CAS_ANALYZER_TIMEOUT=10.0

# Estimate-only mode: predict cost/GPU without actually running the task.
CAS_ESTIMATE_ONLY=false

# Pin a specific GPU model / architecture (empty = let Krauncher choose).
KRAUNCHER_GPU_NAME=
KRAUNCHER_GPU_ARCH=

# --- Advanced / debugging ---
# Stream worker stderr back to the client.
# CAS_STREAM_STDERR=false
# Verbose client logging.
# KRAUNCHER_DEBUG=0
# Relay TLS overrides (normally delivered by the broker per task).
# KRAUNCHER_RELAY_TLS=
# KRAUNCHER_RELAY_CA=
# KRAUNCHER_RELAY_AUTHORITY=
